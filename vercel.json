{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/reindex/ad-copy",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/alerts/daily",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/rules",
      "schedule": "0 3 * * *"
    }
  ]
}
